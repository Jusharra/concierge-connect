# Copy to .env for local development. Never commit real values.
# Server-side secrets below are set ONLY in Netlify (Site settings > Environment variables).
# They are listed here for documentation; none of them may be prefixed VITE_ (that would put them in the browser bundle).

# --- Airtable (system of record) ---
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appzlBMrvpJRpKKQq

# --- Make.com webhook that keeps alerts / follow-ups running ---
MAKE_WEBHOOK_URL=

# --- Stripe (use test keys first) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional ---
# Build hook Airtable/Make calls to rebuild after a Live or price change is documented in README
# URL used by create-checkout for success/cancel redirects; defaults to src/config/site.ts url
SITE_URL_OVERRIDE=
